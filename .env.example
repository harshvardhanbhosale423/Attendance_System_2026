# Copy this file to .env and fill in real values. Never commit the real .env file.

# Flask
FLASK_SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production
FLASK_DEBUG=False

# Database (MariaDB / MySQL)
# DB_ENGINE=sqlite works immediately with zero setup - good for first run/testing.
# Set DB_ENGINE=mysql for real college LAN deployment (requires MariaDB running,
# see README section 4.2).
DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_system
DB_USER=attendance_user
DB_PASSWORD=change-this-password

# Session
SESSION_LIFETIME_MINUTES=60

# Server (used by run scripts / README instructions only)
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Low attendance thresholds (percent) - can also be edited from Admin > Settings after first run
ATTENDANCE_WARNING_THRESHOLD=75
ATTENDANCE_CRITICAL_THRESHOLD=65
